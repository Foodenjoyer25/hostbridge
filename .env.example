# ---------------------------------------------------------------- HostBridge
# Password for the HostBridge web UI (leave empty to disable login - not recommended)
APP_PASSWORD=change-me
# Random string used to sign session cookies (generate: openssl rand -hex 32)
SECRET_KEY=
# Set to true if you serve HostBridge over HTTPS
SECURE_COOKIE=false

# ---------------------------------------------------------------- Nginx Proxy Manager
# Admin UI/API URL (port 81 by default)
NPM_URL=http://192.168.100.30:81
NPM_EMAIL=admin@example.com
NPM_PASSWORD=changeme

# ---------------------------------------------------------------- AdGuard Home
# One or more instances, comma-separated (rewrites are kept in sync on all of them)
ADGUARD_URL=http://192.168.1.11:3000
# Either one value for all instances, or one per instance (comma-separated)
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=changeme
# Optional display names, comma-separated
ADGUARD_NAMES=

# ---------------------------------------------------------------- Defaults
# IP new DNS rewrites point to - normally the machine running NPM
DEFAULT_DNS_ANSWER=192.168.100.30
# Optional: typing "jellyfin" becomes "jellyfin.home.lan"
DEFAULT_DOMAIN_SUFFIX=home.lan
# Used when requesting Let's Encrypt certificates from the UI
LETSENCRYPT_EMAIL=
# Verify TLS certificates of NPM / AdGuard (set false for self-signed)
VERIFY_TLS=true
HOST_PORT=8080
